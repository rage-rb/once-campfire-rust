diff --git a/config/initializers/benchmark_cable_compression.rb b/config/initializers/benchmark_cable_compression.rb
new file mode 100644
index 0000000..1ecc1c0
--- /dev/null
+++ b/config/initializers/benchmark_cable_compression.rb
@@ -0,0 +1,137 @@
+# frozen_string_literal: true
+
+require "zlib"
+
+module BenchmarkRailsCableCompression
+  def self.compress(json)
+    return json if json.bytesize < 256
+
+    # Match bench/rage/lib/benchmark_cable_compression.rb and loadgen's --deflate mode.
+    compressor = Zlib::Deflate.new(6, -Zlib::MAX_WBITS)
+    payload = compressor.deflate(json, Zlib::SYNC_FLUSH)
+    # Keep a text frame, without extension negotiation or RSV1. These bytes are
+    # intentionally incompatible with browsers; this is a benchmark transport.
+    payload.byteslice(0, payload.bytesize - 4).force_encoding(Encoding::UTF_8)
+  ensure
+    compressor&.close
+  end
+
+  # Redis delivers one String to the worker's SubscriberMap before local fan-out.
+  # Keep it String-compatible for custom callbacks; default streams share the
+  # decoded data and one complete envelope per identifier/connection coder.
+  class Broadcast < String
+    attr_reader :data
+
+    def initialize(json)
+      super(json)
+      @payloads = {}
+      @decoded = false
+    end
+
+    def prepare(identifier, coder)
+      key = [identifier, coder]
+      return if @payloads.key?(key)
+
+      unless @decoded
+        @data = ActiveSupport::JSON.decode(self)
+        @decoded = true
+      end
+      @payloads[key] = BenchmarkRailsCableCompression.compress(coder.encode(identifier: identifier, message: data)).freeze
+    end
+
+    def payload(identifier, coder)
+      @payloads.fetch([identifier, coder])
+    end
+  end
+
+  module SubscriberMap
+    def broadcast(channel, message)
+      return super unless message.is_a?(String)
+
+      # Match ActionCable::SubscriptionAdapter::SubscriberMap#broadcast: take a
+      # subscriber snapshot under its lock, then invoke callbacks outside it.
+      list = @sync.synchronize do
+        return unless @subscribers.key?(channel)
+        @subscribers[channel].dup
+      end
+
+      broadcast = Broadcast.new(message)
+      begin
+        list.each do |subscriber|
+          subscriber.prepare_benchmark_broadcast(broadcast) if subscriber.respond_to?(:prepare_benchmark_broadcast)
+        end
+      rescue JSON::ParserError
+        # Keep malformed JSON errors in the channel worker, as in stock Rails,
+        # rather than terminating the Redis listener before callback dispatch.
+        return super
+      end
+      list.each { |subscriber| invoke_callback(subscriber, broadcast) }
+    end
+  end
+
+  module Streams
+    private
+
+    def worker_pool_stream_handler(broadcasting, user_handler, coder: nil)
+      callback = super
+      if !user_handler && (coder.nil? || coder == ActiveSupport::JSON)
+        connection, identifier = self.connection, @identifier
+        callback.define_singleton_method(:prepare_benchmark_broadcast) do |broadcast|
+          connection.prepare_benchmark_broadcast(broadcast, identifier)
+        end
+      end
+      callback
+    end
+
+    def default_stream_handler(broadcasting, coder:)
+      fallback = super
+      return fallback unless coder.nil? || coder == ActiveSupport::JSON
+
+      -> message do
+        if message.is_a?(Broadcast)
+          transmit_benchmark_broadcast(message, via: "streamed from #{broadcasting}")
+        else
+          fallback.call(message)
+        end
+      end
+    end
+
+    def transmit_benchmark_broadcast(broadcast, via:)
+      # Preserve Channel::Base#transmit's logging and notification payload while
+      # sending the already encoded envelope instead of encoding per connection.
+      data = broadcast.data
+      logger.debug { "#{self.class.name} transmitting #{data.inspect.truncate(300)} (via #{via})" }
+      payload = { channel_class: self.class.name, data: data, via: via }
+      ActiveSupport::Notifications.instrument("transmit.action_cable", payload) do
+        connection.transmit_benchmark_broadcast(broadcast, @identifier)
+      end
+    end
+  end
+
+  module Connection
+    def prepare_benchmark_broadcast(broadcast, identifier)
+      broadcast.prepare(identifier, @coder)
+    end
+
+    def transmit_benchmark_broadcast(broadcast, identifier)
+      websocket.transmit broadcast.payload(identifier, @coder)
+    end
+
+    private
+
+    def encode(cable_message)
+      BenchmarkRailsCableCompression.compress(super)
+    end
+  end
+end
+
+if ENV["BENCHMARK_CABLE_COMPRESSION"] == "1"
+  ActiveSupport.on_load(:action_cable_connection) do
+    prepend BenchmarkRailsCableCompression::Connection
+  end
+  ActiveSupport.on_load(:action_cable_channel) do
+    prepend BenchmarkRailsCableCompression::Streams
+  end
+  require "action_cable/subscription_adapter/subscriber_map"
+  ActionCable::SubscriptionAdapter::SubscriberMap.prepend(BenchmarkRailsCableCompression::SubscriberMap)
+end
