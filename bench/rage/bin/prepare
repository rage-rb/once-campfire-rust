#!/usr/bin/env ruby
# One-time benchmark fixture. Never drop or reload an existing database.
ENV["RAILS_ENV"] ||= "production"
ENV["RAGE_ENV"] ||= ENV["RAILS_ENV"]
require_relative "../config/environment"
require "fileutils"
FileUtils.mkdir_p(File.dirname(ActiveRecord::Base.connection_db_config.database))
unless ActiveRecord::Base.connection.table_exists?(:users)
  load "#{CampfireBenchmark::REFERENCE}/db/schema.rb"
end

if User.none?
  if Account.any? || Room.any? || Membership.any?
    raise ArgumentError, "Invalid benchmark dataset: expected an empty first-run database; use a fresh isolated WORK"
  end
  FirstRun.create!(name: "David Hansson", email_address: "david@example.com", password: "secret123456")
end
BenchmarkDataset.validate!
puts "Prepared #{ActiveRecord::Base.connection_db_config.database} (#{User.count} users, #{Room.count} rooms)"
